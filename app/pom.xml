<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>com.dataplatform</groupId>
    <artifactId>flink-kinesis-app</artifactId>
    <version>1.1.0</version>

    <!--
        Versiones alineadas con el runtime FLINK-1_19 de Managed Service for Apache Flink.
        Flink, el conector de Kinesis e Iceberg deben coincidir en la version menor de Flink
        (sufijo -1.19): mezclarlas provoca errores de serializacion en el runtime.
        Iceberg 1.6.1 + Hadoop 3.4.0 es la combinacion de los ejemplos oficiales de AWS para Flink 1.19.
    -->
    <properties>
        <maven.compiler.source>11</maven.compiler.source>
        <maven.compiler.target>11</maven.compiler.target>
        <flink.minor.version>1.19</flink.minor.version>
        <kinesis.connector.version>4.3.0-1.19</kinesis.connector.version>
        <iceberg.version>1.6.1</iceberg.version>
        <hadoop.version>3.4.0</hadoop.version>
    </properties>

    <dependencies>
        <!-- Solo para compilar HadoopUtils (src/main/java); lo provee el runtime -->
        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-core</artifactId>
            <version>1.19.1</version>
            <scope>provided</scope>
        </dependency>

        <!-- Fuente: Kinesis Data Streams (tabla SQL 'kinesis') -->
        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-connector-kinesis</artifactId>
            <version>${kinesis.connector.version}</version>
        </dependency>

        <!-- Sink Iceberg para Flink 1.19 (catalogo 'iceberg', FlinkSink/IcebergSink) -->
        <dependency>
            <groupId>org.apache.iceberg</groupId>
            <artifactId>iceberg-flink-runtime-${flink.minor.version}</artifactId>
            <version>${iceberg.version}</version>
        </dependency>

        <!-- GlueCatalog, S3FileIO y el AWS SDK v2 que usan (iceberg-aws empaquetado) -->
        <dependency>
            <groupId>org.apache.iceberg</groupId>
            <artifactId>iceberg-aws-bundle</artifactId>
            <version>${iceberg.version}</version>
        </dependency>

        <!-- Iceberg-Flink necesita las clases de configuracion de Hadoop, que Managed Flink no trae -->
        <dependency>
            <groupId>org.apache.hadoop</groupId>
            <artifactId>hadoop-client</artifactId>
            <version>${hadoop.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>org.apache.avro</groupId>
                    <artifactId>avro</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.slf4j</groupId>
                    <artifactId>slf4j-reload4j</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.3</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <outputFile>${project.build.directory}/pyflink-dependencies.jar</outputFile>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <artifactSet>
                                <excludes>
                                    <!-- El runtime de Flink ya provee logging -->
                                    <exclude>org.slf4j:*</exclude>
                                    <exclude>org.apache.logging.log4j:*</exclude>
                                    <exclude>log4j:*</exclude>
                                    <exclude>ch.qos.reload4j:*</exclude>
                                    <exclude>com.google.code.findbugs:jsr305</exclude>
                                    <!-- Lo trae hadoop-client y ya lo usa el PythonDriver de Flink:
                                         duplicarlo causa "LinkageError: loader constraint violation" -->
                                    <exclude>commons-cli:commons-cli</exclude>
                                </excludes>
                            </artifactSet>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <!-- Iceberg + Hadoop en Managed Flink (ver src/main/java/.../HadoopUtils.java):
                                 HadoopUtils propio y Configuration de Hadoop quedan en paquetes del JAR,
                                 fuera de los patrones parent-first del classloader de Flink. -->
                            <relocations>
                                <relocation>
                                    <pattern>org.apache.hadoop.conf</pattern>
                                    <shadedPattern>shaded.org.apache.hadoop.conf</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>org.apache.flink.runtime.util.HadoopUtils</pattern>
                                    <shadedPattern>shadow.org.apache.flink.runtime.util.HadoopUtils</shadedPattern>
                                </relocation>
                            </relocations>
                            <transformers>
                                <!-- Fusiona los META-INF/services: fabricas de Kinesis e Iceberg -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
